{
  "manifest_version": 3,
  "name": "Promty",
  "version": "1.0.0",
  "description": "Automate Your Browser Work With One Sentence",

  "permissions": ["tabs", "activeTab", "storage", "scripting", "notifications", "sidePanel"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Buka Promty",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
